GROQ_API_KEY=replace_with_your_groq_key
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_REASONING=llama-3.3-70b-versatile
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35
# Defaults to a local SQLite file if unset -- only set this to point at the
# docker-compose postgres service (or another real Postgres instance).
DATABASE_URL=postgresql+asyncpg://mapping_assistant:mapping_assistant@localhost:5435/mapping_assistant
# Publish is unavailable until both of these are set. Create a Bot Password
# at Special:BotPasswords on mappings.dbpedia.org -- never a real account
# password. MEDIAWIKI_BOT_USERNAME is the full "User@BotName" form.
MEDIAWIKI_BASE_URL=https://mappings.dbpedia.org
MEDIAWIKI_BOT_USERNAME=
MEDIAWIKI_BOT_PASSWORD=
